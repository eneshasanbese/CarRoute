# Backend REST API adresi (sonunda / olmadan)
VITE_API_BASE_URL=http://localhost:8080

# Tarayıcı içi sahte veri katmanı. Backend çalışmıyorken "true" yapılabilir.
VITE_USE_MOCK=false

# Adres autocomplete sağlayıcısı: "nominatim" (key gerektirmez) veya "none"
VITE_GEOCODING_PROVIDER=nominatim
# Nominatim dışında bir sağlayıcı kullanılacaksa key buraya
VITE_GEOCODING_API_KEY=
